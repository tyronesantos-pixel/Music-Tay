{
  "entities": {
    "user_libraries": {
      "title": "User Libraries",
      "description": "User personal library containing all saved YouTube clips, playlists, liked tracks, and history synchronized in real-time in cloud",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "videos": { "type": "array" },
        "collections": { "type": "array" },
        "likedVideoIds": { "type": "array" },
        "watchHistory": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "videos": {
      "title": "Videos",
      "description": "YouTube videos added by users and synchronized in real-time in the cloud",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "title": { "type": "string" },
        "channelTitle": { "type": "string" },
        "channelUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "duration": { "type": "number" },
        "isShort": { "type": "boolean" },
        "tags": { "type": "array" },
        "notes": { "type": "string" },
        "category": { "type": "string" },
        "userId": { "type": "string" },
        "addedAt": { "type": "string" },
        "lastSyncedAt": { "type": "string" }
      },
      "required": ["id", "youtubeUrl", "title", "channelTitle", "thumbnailUrl"]
    },
    "collections": {
      "title": "Collections",
      "description": "Playlists and collections of videos personal to each user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "color": { "type": "string" },
        "videoIds": { "type": "array" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "users": {
      "title": "Users",
      "description": "User accounts with encrypted credentials for cross-device authentication and access approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameLower": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "accessStatus": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "passwordHash"]
    }
  },
  "firestore": {
    "/user_libraries/{userId}": {
      "schema": "user_libraries",
      "description": "Dedicated real-time user library store"
    },
    "/videos/{videoId}": {
      "schema": "videos",
      "description": "YouTube video document indexed by video ID"
    },
    "/collections/{collectionId}": {
      "schema": "collections",
      "description": "Playlists and video collections"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User authentication and profile accounts"
    }
  }
}
