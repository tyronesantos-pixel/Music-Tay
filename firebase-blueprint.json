{
  "entities": {
    "videos": {
      "title": "Videos",
      "description": "YouTube videos added by users and synchronized in real-time in the cloud",
      "properties": {
        "id": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "title": { "type": "string" },
        "channelTitle": { "type": "string" },
        "channelUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "duration": { "type": "number" },
        "isShort": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "addedAt": { "type": "string" },
        "lastSyncedAt": { "type": "string" }
      },
      "required": ["id", "youtubeUrl", "title", "channelTitle", "thumbnailUrl"]
    },
    "collections": {
      "title": "Collections",
      "description": "Playlists and collections of videos",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "videoIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /videos/{videoId} {\n      allow read, write: if true;\n    }\n    match /collections/{collectionId} {\n      allow read, write: if true;\n    }\n    match /channels/{channelId} {\n      allow read, write: if true;\n    }\n  }\n}"
}
