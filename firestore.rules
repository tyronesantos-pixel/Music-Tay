rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_libraries/{userId} {
      allow read, write: if true;
    }
    match /videos/{videoId} {
      allow read, write: if true;
    }
    match /collections/{collectionId} {
      allow read, write: if true;
    }
    match /channels/{channelId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
